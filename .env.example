# Copy to .env and fill in. Inside the IBM Skills Network Cloud IDE none of
# these are required: credentials are injected and the project id is
# "skills-network".

# --- IBM watsonx.ai (used by the vision & dietary-filter tools) ---
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# --- Models (optional overrides) ---
# NOURISHBOT_VISION_MODEL=meta-llama/llama-3-2-90b-vision-instruct
# NOURISHBOT_TEXT_MODEL=ibm/granite-4-h-small
# NOURISHBOT_VISION_MAX_TOKENS=300
# NOURISHBOT_TEXT_MAX_TOKENS=150

# --- LLM that the CrewAI agents use to reason (optional) ---
# Leave unset to use CrewAI's default (OpenAI, needs OPENAI_API_KEY).
# Any LiteLLM model string works, e.g. a watsonx model:
# NOURISHBOT_AGENT_LLM=watsonx/meta-llama/llama-3-3-70b-instruct
# (LiteLLM's watsonx provider reads WATSONX_URL, WATSONX_APIKEY, WATSONX_PROJECT_ID)
# OPENAI_API_KEY=

# --- Web server ---
# NOURISHBOT_HOST=127.0.0.1
# NOURISHBOT_PORT=5000
